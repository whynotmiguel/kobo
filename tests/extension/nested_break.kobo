// Break in nested while loops - breaks only innermost
var i = 0;
while (i < 3) {
    var j = 0;
    while (j < 5) {
        if (j == 2) {
            break;
        }
        print j;
        j = j + 1;
    }
    print "outer";
    i = i + 1;
}
// expect: 0
// expect: 1
// expect: outer
// expect: 0
// expect: 1
// expect: outer
// expect: 0
// expect: 1
// expect: outer